# Base URL the browser calls for the API, including the /v1 prefix.
# Baked into the client bundle at build time (Next.js only exposes
# NEXT_PUBLIC_* vars to the browser) — changing this after `next build`
# requires a rebuild, it cannot be swapped at container-start like a normal
# runtime env var. Defaults to http://localhost:3001/v1 if unset, which
# matches the API's default local port (see apps/api/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
