# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (required — the app fails to start without this; the
# multi-schema setup is controlled by datasource.schemas in schema.prisma,
# not a ?schema= query param, so none is needed here)
DATABASE_URL=postgresql://pinoytax:pinoytax_dev_password@localhost:5432/pinoytax_ai

# Redis (required — session/rate-limit state and the BullMQ job queue both
# depend on it; the app will fail health checks and background jobs won't
# run without it, even though boot itself doesn't hard-fail on a bad value)
REDIS_URL=redis://localhost:6379

# RabbitMQ (required — inter-service events; same failure mode as Redis
# above, background processing degrades rather than boot failing outright)
RABBITMQ_URL=amqp://pinoytax:pinoytax_dev_password@localhost:5672

# JWT (required — the app fails to start without this)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random values hashed into identity.sessions, not
# JWTs, so there is no JWT_REFRESH_SECRET to configure — only their lifetime.
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d

# Email (SMTP) — required for real use: registration/password-reset emails
# fail silently (logged, not thrown — see mailer.service.ts) if these are
# wrong, which blocks users from ever verifying an account.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM="PinoyTax AI <no-reply@pinoytax.ai>"

# Frontend URL (required — used for CORS, cookie scoping, and email links)
APP_WEB_URL=http://localhost:3000

# Object storage (S3-compatible) — required for the Document Vault feature;
# uploads/downloads fail cleanly with an error response if unset, nothing
# else in the app depends on it.
S3_ENDPOINT=
S3_BUCKET=pinoytax-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-1

# AI Service — required for the AI Tax Assistant feature only; requests to
# it fail cleanly with an error response if unset, nothing else depends on it.
ANTHROPIC_API_KEY=

# Account lockout policy (optional — these are the defaults already applied
# in code if left unset; set explicitly only to change the policy)
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# SMS gateway (optional — provider-agnostic, see
# notifications/channels/sms.channel.ts; SMS notifications are just skipped
# if unset, nothing else depends on it)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Firebase Cloud Messaging (optional — push notifications are just skipped
# if unset, nothing else depends on it)
FCM_SERVER_KEY=

# Platform admin seed (optional — only used by `npm run prisma:seed`; if
# unset, no platform admin is created and you promote one manually later)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
